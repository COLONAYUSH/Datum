{
  "name": "@colonayush/datumrag",
  "version": "0.1.0",
  "description": "Node/TypeScript client for Datum, a retrieval substrate for AI agents. Talks to a running `datum serve-http` server; does not embed the framework itself (Python + PostgreSQL by design).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/COLONAYUSH/Datum.git",
    "directory": "clients/node"
  },
  "homepage": "https://github.com/COLONAYUSH/Datum/tree/main/clients/node#readme",
  "bugs": "https://github.com/COLONAYUSH/Datum/issues",
  "keywords": [
    "rag",
    "retrieval",
    "retrieval-augmented-generation",
    "datum",
    "ai-agents",
    "mcp",
    "search"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
