# GitHub Actions CI for Datum (TEMPLATE).
#
# This is kept here, not at .github/workflows/ci.yml, because pushing a file
# under .github/workflows/ needs a GitHub token with the `workflow` scope, and
# the initial push used a token that only had `repo`. The workflow itself is
# ready to use.
#
# To activate CI:
#   1. gh auth refresh -h github.com -s workflow
#   2. mkdir -p .github/workflows && git mv docs/ci.yml.template .github/workflows/ci.yml
#   3. git commit -m "Add CI workflow" && git push
#
# ---------------------------------------------------------------------------

name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    name: tests (py${{ matrix.python-version }})
    runs-on: ubuntu-latest

    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.11", "3.12"]

    # Postgres 17 with pgvector already built in, so the vector extension is available.
    services:
      postgres:
        image: pgvector/pgvector:pg17
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: datum_ci
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5

    env:
      DATUM_PG_DSN: "postgresql://postgres:postgres@localhost:5432/datum_ci"
      DATUM_HIT_SIGNING_KEY: "ci-test-key"
      PGPASSWORD: postgres

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip

      - name: Enable the vector extension
        run: psql "$DATUM_PG_DSN" -c "CREATE EXTENSION IF NOT EXISTS vector;"

      # The embedding model and reranker download from HuggingFace on first use.
      - name: Cache HuggingFace models
        uses: actions/cache@v4
        with:
          path: ~/.cache/huggingface
          key: hf-${{ runner.os }}-bge-small-reranker-base

      - name: Install Datum (dev + embed extras)
        run: |
          python -m pip install --upgrade pip
          pip install -e '.[dev,embed]'

      - name: Run the test suite
        run: python -m pytest -q
